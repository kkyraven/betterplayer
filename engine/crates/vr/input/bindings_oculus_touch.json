{
  "controller_type": "oculus_touch",
  "name": "Better Player: Touch",
  "description": "Better Player defaults",
  "bindings": {
    "/actions/watch": {
      "sources": [
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/play_pause"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/play_pause"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/back"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/back"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/controls"
            },
            "position": {
              "output": "/actions/watch/in/seek"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "dpad",
          "parameters": {
            "sub_mode": "touch",
            "deadzone_pct": "70",
            "overlap_pct": "0",
            "sticky": "true"
          },
          "inputs": {
            "north": {
              "output": "/actions/watch/in/volume_up"
            },
            "south": {
              "output": "/actions/watch/in/volume_down"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/controls"
            },
            "position": {
              "output": "/actions/watch/in/seek"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "dpad",
          "parameters": {
            "sub_mode": "touch",
            "deadzone_pct": "70",
            "overlap_pct": "0",
            "sticky": "true"
          },
          "inputs": {
            "north": {
              "output": "/actions/watch/in/volume_up"
            },
            "south": {
              "output": "/actions/watch/in/volume_down"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/point_left"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/grip_left"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/point_right"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/watch/in/grip_right"
            }
          }
        }
      ],
      "chords": [
        {
          "output": "/actions/watch/in/stop",
          "inputs": [
            [
              "/user/hand/right/input/a",
              "click"
            ],
            [
              "/user/hand/right/input/b",
              "click"
            ]
          ]
        },
        {
          "output": "/actions/watch/in/stop",
          "inputs": [
            [
              "/user/hand/left/input/x",
              "click"
            ],
            [
              "/user/hand/left/input/y",
              "click"
            ]
          ]
        }
      ],
      "haptics": [
        {
          "output": "/actions/watch/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/watch/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/watch/in/aim_left",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/watch/in/aim_right",
          "path": "/user/hand/right/pose/tip"
        }
      ]
    }
  }
}
